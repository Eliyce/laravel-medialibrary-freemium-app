{
    "name": "eliyce/laravel-media-pro",
    "description": "Temporary uploads, upload routes, request handling and validation rules for the @eliyce/media-pro components on top of spatie/laravel-medialibrary.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "media",
        "medialibrary",
        "uploads",
        "react"
    ],
    "authors": [
        {
            "name": "Eliyce"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^10.2|^11.0|^12.0|^13.0",
        "illuminate/config": "^10.2|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.2|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.2|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.2|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.2|^11.0|^12.0|^13.0",
        "illuminate/log": "^10.2|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.2|^11.0|^12.0|^13.0",
        "illuminate/session": "^10.2|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.2|^11.0|^12.0|^13.0",
        "illuminate/validation": "^10.2|^11.0|^12.0|^13.0",
        "laravel/framework": "^10.2|^11.0|^12.0|^13.0",
        "spatie/laravel-medialibrary": "^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.22|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Eliyce\\MediaPro\\": "laravel/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eliyce\\MediaPro\\Tests\\": "laravel/tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eliyce\\MediaPro\\MediaProServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
