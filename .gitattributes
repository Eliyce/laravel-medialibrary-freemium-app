# GitHub builds its download archives with `git archive`, so export-ignore decides what both
# installs from this repository receive:
# - Composer (vcs or dist) needs composer.json, laravel/src, laravel/config and laravel/database.
# - npm installs a git dependency from the same archive and builds dist/ in its `prepare` script,
#   so package.json, package-lock.json, src/, styles/, tsconfig.json and tsup.config.ts must ship.
# Everything below is tests, docs or local tooling.

/.changeset export-ignore
/.claude export-ignore
/.github export-ignore
/.kilo export-ignore
/.paqad export-ignore
/docs export-ignore
/dist export-ignore
/node_modules export-ignore
/tests export-ignore
/laravel/tests export-ignore
/vendor export-ignore

/.gitattributes export-ignore
/.gitignore export-ignore
/.npmrc export-ignore
/.prettierignore export-ignore
/.prettierrc.json export-ignore
/CHANGELOG.md export-ignore
/CLAUDE.md export-ignore
/AGENTS.md export-ignore
/composer.lock export-ignore
/eslint.config.js export-ignore
/phpunit.xml.dist export-ignore
/postcss.config.* export-ignore
/tailwind.config.* export-ignore
/tsconfig.*.json export-ignore
/vite.config.* export-ignore
/vitest.config.ts export-ignore
